GMAIL_ADDRESS=you@gmail.com
# Google Account > Security > 2-Step Verification > App passwords (IMAP must be enabled)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# BACKEND=api (default) bills the API key. BACKEND=claude-cli bills your Claude subscription:
# run `claude setup-token` on a machine where you are logged in and paste the token below.
BACKEND=api
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=

# Web login. Make the password long. SECRET_KEY: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_USERNAME=sam
APP_PASSWORD=change-me-to-a-long-passphrase
SECRET_KEY=
# Set to 1 once the site is served over https
# COOKIE_SECURE=1

POLL_MINUTES=30
# MODEL=claude-haiku-5-5   # default is claude-opus-5-5 for api, claude-haiku-5-5 for claude-cli

# Optional alerts when something new needs you (short text only, no email content)
# NTFY_URL=https://ntfy.sh/pick-a-long-random-topic
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=...
# HA_NOTIFY_SERVICE=notify/mobile_app_your_phone
